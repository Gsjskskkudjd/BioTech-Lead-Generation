# Google Gemini API Key (required)
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Email for PubMed API (required for biotech lead generator)
EMAIL=your_email@example.com

# Telegram Bot Credentials (optional, for alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Google Sheets Credentials (optional, for publishing)
# Place your service account JSON file as google_creds.json in the project root
# Or set GOOGLE_CREDS_JSON to the filename
GOOGLE_CREDS_JSON=google_creds.json
